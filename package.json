{
  "name": "aventics-product-scraper",
  "version": "0.2.4",
  "description": "Desktop AVENTICS catalog data tool with batch scraping, asset extraction, data quality, historical comparison, product browser, and Excel/CSV/JSON export.",
  "main": "./out/main/index.js",
  "author": "Internal Engineering Tool",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "postinstall": "electron-builder install-app-deps",
    "doctor": "node scripts/doctor.mjs",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "dist:portable": "npm run build && electron-builder --win portable",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cheerio": "1.1.2",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "p-queue": "6.6.2",
    "pino": "9.5.0",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.20",
    "electron": "44.3.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
